"""Tests for rules_argo_rollouts.

- Analysis test verifies the macro instantiates cleanly.
- Smoke composition: kind cluster + Argo Rollouts (single
  Deployment + 5 CRDs). Smoke applies a blueGreen Rollout, waits
  for Healthy, patches the image, asserts the new RS gets
  promoted and the active Service's selector flips to the new
  pod-template-hash.
"""

load("@rules_argo_rollouts//:defs.bzl", "argo_rollouts_health_check", "argo_rollouts_install")
load("@rules_itest//:itest.bzl", "itest_service", "service_test")
load("@rules_kind//:defs.bzl", "kind_cluster", "kind_health_check")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":analysis_tests.bzl", "argo_rollouts_install_test_suite")

# ---- analysis ---------------------------------------------------------------

argo_rollouts_install_test_suite(name = "argo_rollouts_install_analysis")

# ---- smoke composition ------------------------------------------------------

kind_cluster(name = "cluster", k8s_version = "1.35")

kind_health_check(name = "cluster_health", cluster = ":cluster")

itest_service(
    name = "kind_svc",
    exe = ":cluster",
    health_check = ":cluster_health",
    tags = ["manual"],
)

argo_rollouts_install(
    name = "argo_rollouts_install_bin",
    tags = ["manual"],
)

argo_rollouts_health_check(
    name = "argo_rollouts_health_bin",
    tags = ["manual"],
)

sh_binary(
    name = "argo_rollouts_install_wrapper",
    srcs = ["install_wrapper.sh"],
    data = [":argo_rollouts_install_bin"],
)

sh_binary(
    name = "argo_rollouts_health_wrapper",
    srcs = ["health_wrapper.sh"],
    data = [":argo_rollouts_health_bin"],
)

itest_service(
    name = "argo_rollouts_svc",
    exe = ":argo_rollouts_install_wrapper",
    deps = [":kind_svc"],
    health_check = ":argo_rollouts_health_wrapper",
    tags = ["manual"],
)

sh_test(
    name = "smoke_test_bin",
    srcs = ["smoke_test.sh"],
    data = ["fixtures/rollout.yaml"],
    tags = ["manual"],
)

service_test(
    name = "smoke_test",
    services = [":argo_rollouts_svc"],
    test = ":smoke_test_bin",
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
)
